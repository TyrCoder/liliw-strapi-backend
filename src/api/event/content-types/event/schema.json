{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "date_start": {
      "type": "datetime"
    },
    "date_end": {
      "type": "datetime"
    },
    "venue": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "festival",
        "cultural",
        "competition",
        "other"
      ]
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "videos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["videos"]
    },
    "program": {
      "type": "blocks"
    },
    "is_featured": {
      "type": "boolean"
    },
    "is_joinable": {
      "type": "boolean",
      "default": false
    },
    "max_participants": {
      "type": "integer"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "signups": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-signup.event-signup",
      "mappedBy": "event"
    }
  }
}
